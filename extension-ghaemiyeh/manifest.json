{
  "manifest_version": 3,
  "name": "Ghaemiyeh Book Collector",
  "version": "1.0",
  "description": "تریس مجموعهٔ کتب یک نفر در غایمیه، دانلود همه و افزودن به یک کالکشن پیکره.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.ghaemiyeh.ir/*",
    "https://ghaemiyeh.ir/*",
    "https://corpus.ai.ismc.ir/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ghaemiyeh Book Collector"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ghaemiyeh.ir/*", "https://ghaemiyeh.ir/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
