--- compose.gateway.yml (sk-/rc- values masked):
# Universal RAG Gateway (E2). OpenAI-compatible front for multi-RAG.
#
# network_mode: host is REQUIRED: the gateway talks to the central registry
# (127.0.0.1:8200) and to the providers (127.0.0.1:8101/8102) on host
# loopback — the same loopback the providers themselves bind. The gateway
# also reaches LiteLLM on the host (GATEWAY_LLM_ENDPOINT, port 4101) and the
# model-only alias it forwards to. Like the registry, keep the gateway
# behind the host firewall.
services:
  rag-gateway:
    build:
      context: .
      dockerfile: Dockerfile.gateway
    image: rag-gateway:0.1.0
    container_name: rag-gateway
    restart: unless-stopped
    network_mode: host
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "3" }
    deploy:
      resources:
        limits: { cpus: "2.0", memory: 1G }
    volumes:
      - ./openapi:/app/openapi:ro
    env_file:
      - ./env/gateway.env
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8210/health',timeout=4).status==200 else 1)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

