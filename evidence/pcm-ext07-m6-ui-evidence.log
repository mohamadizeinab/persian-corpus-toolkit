[M6-D] Extension start flow (background.js lines 92–225, read-only)
--------------------------------------------------------------------------------
runPhase1('khamenei'):
  crawlState.khamenei = {nextYear:null, emptyStreak:0, MIN_YEAR:1370, ids:[],
                         idx:0, delayMs:2000, errors:0}
  -> opens unfiltered https://farsi.khamenei.ir/speech (seeds the LATEST year)
  -> nextKhameneiYear(state, msg) after each list page:
       first: nextYear = msg.maxYear || 1404
       total === 0 -> emptyStreak++  else emptyStreak = 0
       nextYear -= 1
       stop: emptyStreak >= 2 -> {done, reason:'empty'}
             nextYear < MIN_YEAR -> {done, reason:'floor'}
       else navigate /speech?nt=2&year=nextYear
runPhase2('khamenei'):
  -> fetchPendingKhameneiIds() = GET /api/phase2/next-batch?site=khamenei&limit=500
     (ids parsed from queued url .../speech-content?id=NNN)
  -> navigateKhameneiDetail() visits each detail page; content script
     extractAndSubmit() POSTs /api/phase2/complete; backend dedups
     (server.py:458–504 _phase2_save_khamenei)
  -> no pending ids: checks /api/pipeline/status?site=khamenei ->
     "همه بیانات ذخیره شده‌اند" or "صف بیانات خالی است — اول فاز ۱ را بزنید"

